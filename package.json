{
  "name": "birlik-company-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-cms.mjs && tsx scripts/gen-article-summaries.ts && vitest run && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts && tsx scripts/check-dist.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "cms": "tinacms dev -c \"vite --port 4176\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "nodemailer": "6.9.16",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tinacms": "3.15.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tinacms/cli": "4.0.3",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "6.4.17",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7"
  }
}
